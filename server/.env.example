# Server environment variables
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/store3d

# JWT secrets
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Bank transfer (VietQR) configuration
BANK_BIN=970423
BANK_ACCOUNT_NUMBER=YOUR_BANK_ACCOUNT_NUMBER
BANK_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
BANK_ACCOUNT_DISPLAY_NAME=YOUR_ACCOUNT_DISPLAY_NAME
QR_TTL_MINUTES=5
PAYMENT_WEBHOOK_SECRET=

# Cloudinary (image upload) — get from https://cloudinary.com Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP / Email (Gmail with 2-Step Verification + App Password)
# Create a dedicated Gmail, enable 2-Step Verification, generate App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_store_email@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_FROM="Store3D <your_store_email@gmail.com>"
MAIL_SUPPORT=your_store_email@gmail.com

# AI Chat (optional - mock provider used if not set)
AI_PROVIDER=mock
AI_MODEL=gpt-3.5-turbo
AI_API_KEY=your_api_key_here

# Gemini (image generation for mini-game assets)
GEMINI_API_KEY=

# Reward Game (optional)
REWARD_COUPON_EXPIRY_DAYS=14
GAME_SESSION_TIMEOUT_MINUTES=5

# Seed credentials (used ONLY by `npm run seed` — never by the running server)
# Each password must be strong: at least 12 characters incl. letters and digits.
# Leave empty to skip creating the corresponding account when seeding.
# Do not reuse any real user password here.
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
